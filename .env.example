# Base URL of the deployed Splitcore backend API.
# Server-side only: this frontend proxies ALL backend calls through its own server
# (see docs/api-audit.md §4.4 — the backend 500s on any request carrying an Origin header).
API_BASE_URL=https://splitcore-api.onrender.com

# This frontend's own canonical origin. Used to build the URL encoded into QR codes:
#   https://<NEXT_PUBLIC_APP_URL>/t/{public_token}
# Set per environment. On Netlify this is derived automatically from $URL if unset.
#   local:      http://localhost:3000
#   production: https://splitcore-app.netlify.app  (or the custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to encrypt the httpOnly session cookie holding the backend JWT.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-32-byte-random-string
