:{"application/json":{"schema":{"$ref":"#/components/schemas/QrResolutionResponseDto"}}}},"404":{"description":"QR code not found (token does not exist)"},"410":{"description":"Gone - QR code, venue, or entertainer is deactivated"}},"summary":"Resolve QR code and create guest session (public, no auth required)","tags":["Guest"]}},"/split-rules":{"post":{"description":"The venue proposes only its own and the entertainer's shares, which must sum to 10000 minus the platform fee (see GET /platform/settings). A payload containing platformBps is rejected with 400 — the platform's cut is server-side only. The rule is created PENDING_ENTERTAINER_APPROVAL and does not divide any money until the entertainer accepts it via the returned consentUrl.","operationId":"SplitRulesController_propose","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateSplitRuleDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SplitRuleProposalResponseDto"}}}},"400":{"description":"Shares do not sum correctly, platformBps was supplied, or entertainer is not linked to the venue"},"403":{"description":"Forbidden - access denied to this venue"}},"security":[{"bearer":[]}],"summary":"Propose a venue/entertainer split (does NOT take effect yet)","tags":["Split Rules"]}},"/split-rules/override":{"post":{"description":"Bypasses entertainer consent and takes effect immediately. For genuine operational necessity such as dispute resolution. The rule is stamped origin=ADMIN_OVERRIDE and the reason is written to the immutable audit trail, so it can never be mistaken for terms an entertainer agreed to.","operationId":"SplitRulesController_override","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OverrideSplitRuleDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/compo